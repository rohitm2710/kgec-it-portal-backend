  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.1",
    "@types/ws": "^8.5.14",
    "@vercel/node": "^30.0.0",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.2",
