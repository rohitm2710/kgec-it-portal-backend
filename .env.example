# ==============================================================================
# KGEC IT Department Portal — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual production/staging credentials.
# NEVER commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
# Generate a strong, high-entropy 256-bit secret string for token signing
JWT_SECRET="replace_with_your_secure_256_bit_jwt_secret_key"
JWT_EXPIRES_IN="7d"

# Neon Serverless Postgres Database Connection Strings
# 1. DATABASE_URL: Pooled connection string for regular queries & transactions (port 6543)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. DIRECT_URL: Direct unpooled connection string for schema migrations (drizzle-kit push/migrate)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# OpenRouter AI Engine (for SAQ/LAQ AI Grading & Semantic Model Verification)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key-here"
OPENROUTER_DEFAULT_MODEL="google/gemini-2.5-pro"
OPENROUTER_SITE_URL="https://it.kgec.edu.in"
OPENROUTER_APP_NAME="KGEC-IT-Department-Portal"

# External OCR Provider (for handwritten / scanned physical copy answer extraction)
OCR_PROVIDER_API_KEY="your-ocr-api-key-here"
OCR_PROVIDER_ENDPOINT="https://your-ocr-endpoint.example.com/v1/extract"
